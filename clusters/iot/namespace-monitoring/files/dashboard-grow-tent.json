{
  "uid": "grow-tent",
  "title": "Grow Tent",
  "tags": [
    "iot",
    "grow",
    "wio"
  ],
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": "InfluxDB",
        "query": "SHOW TAG VALUES FROM \"temperature\" WITH KEY = \"device\" WHERE \"group\" = 'grow'",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "mode",
        "label": "Mode (targets)",
        "type": "custom",
        "query": "veg,flower,dry,cure",
        "current": {
          "selected": true,
          "text": "flower",
          "value": "flower"
        },
        "options": [
          {
            "text": "veg",
            "value": "veg",
            "selected": false
          },
          {
            "text": "flower",
            "value": "flower",
            "selected": true
          },
          {
            "text": "dry",
            "value": "dry",
            "selected": false
          },
          {
            "text": "cure",
            "value": "cure",
            "selected": false
          }
        ],
        "description": "Which mode's target bands the tiles show. Set it to the Device mode tile."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Device",
      "datasource": "InfluxDB",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT last(\"value\") FROM \"grow_status\" WHERE \"device\" =~ /^$device$/ AND $timeFilter",
          "resultFormat": "time_series",
          "policy": "default"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "mappings": [
            {
              "type": "value",
              "options": {
                "online": {
                  "text": "ONLINE",
                  "color": "green"
                },
                "offline": {
                  "text": "OFFLINE",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "description": "MQTT last-will: 'offline' when the Wio Terminal drops off the broker."
