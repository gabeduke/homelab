    {
      "id": 15,
      "type": "table",
      "title": "Settings in force",
      "datasource": "InfluxDB",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "description": "Echo of grow/<device>/config/applied (last 90 days). 'errors' lists config fields the device rejected; empty means all accepted.",
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT last(\"leaf_offset_c\") AS \"leaf_offset_c\", last(\"sample_interval_s\") AS \"sample_interval_s\", last(\"screen_timeout_s\") AS \"screen_timeout_s\", last(\"window\") AS \"window\", last(\"enable_co2\") AS \"enable_co2\", last(\"mode\") AS \"mode\", last(\"errors\") AS \"errors\" FROM \"grow_config\" WHERE \"device\" =~ /^$device$/ AND time > now() - 90d",
          "resultFormat": "time_series",
          "policy": "default"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
